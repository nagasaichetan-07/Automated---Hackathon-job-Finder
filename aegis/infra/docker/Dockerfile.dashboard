# Multi-stage Dockerfile for Aegis React Dashboard
FROM node:20-alpine AS builder

WORKDIR /app

COPY aegis/apps/dashboard/package*.json ./
RUN npm ci

COPY aegis/apps/dashboard ./
RUN npm run build

FROM nginx:alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
